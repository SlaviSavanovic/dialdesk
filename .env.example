# dialdesk secrets. The setup wizard at http://localhost:3000 writes this file
# for you, so you should never need to open it. Never paste these into a chat.

# Voice platforms. You only need the one you use.
BLAND_API_KEY=
VAPI_API_KEY=
RETELL_API_KEY=
ELEVENLABS_API_KEY=
SYNTHFLOW_API_KEY=

# Optional services Claude can use during setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=

# The only number the test call button can reach.
MY_PHONE=

# off = dry run. The scheduler runs and every call is simulated.
# Turned on from the Go live screen.
LIVE_CALLS=off
