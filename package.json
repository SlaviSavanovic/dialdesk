{
  "name": "dialdesk",
  "version": "0.1.0",
  "private": true,
  "description": "A local AI calling desk you run with Claude Code. Leads go in, an AI voice agent calls them on a schedule, you watch it happen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "node cli/check-node.mjs",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "api": "node --disable-warning=ExperimentalWarning cli/api.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node cli/smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "csv-parse": "^7.0.3",
    "hono": "^4.13.16",
    "libphonenumber-js": "^1.13.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
