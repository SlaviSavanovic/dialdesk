{
  // Node runs the .ts files directly by stripping the types, so nothing is ever
  // compiled. `npm run typecheck` is the only thing that reads this file.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "cli", "test"]
}
